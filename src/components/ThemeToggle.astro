---
// A small switch that overrides the OS colour scheme. The knob is a filled
// disc in light mode; in dark mode it slides to the far end and an inset
// shadow bites a crescent out of it.
---
<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  role="switch"
  aria-checked="false"
  aria-label="Dark mode"
  title="Toggle dark mode"
>
  <span class="track" aria-hidden="true"><span class="knob"></span></span>
</button>

<style>
  .theme-toggle {
    /* A bare control: no button chrome, just the track it draws itself. */
    -webkit-appearance: none;
    appearance: none;
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0;
    margin: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    /* Wide enough to be an easy target, but only the track is visible. */
    width: 2.6rem;
  }

  .track {
    /* One set of numbers drives the whole shape, so the knob's inset, its
       travel and the track stay in proportion however these are tuned. */
    --track-w: 2.05rem;
    --track-h: 1.05rem;
    --knob: 0.62rem;
    --edge: 1px;
    --inset: calc((var(--track-h) - 2 * var(--edge) - var(--knob)) / 2);

    position: relative;
    display: block;
    width: var(--track-w);
    height: var(--track-h);
    border: var(--edge) solid var(--rule);
    border-radius: 999px;
    transition: border-color 0.25s ease;
  }
  .theme-toggle:hover .track { border-color: var(--muted); }

  .theme-toggle:focus-visible {
    outline: none;
  }
  .theme-toggle:focus-visible .track {
    outline: 1px solid var(--muted);
    outline-offset: 3px;
  }

  /* The knob has no background of its own: both the sun and the moon are drawn
     entirely by one inset shadow, which is clipped to the circle and so can
     never spill over the track's rule. Spread equal to the radius fills the
     disc (with a pixel to spare, so no pinhole survives rounding); trading
     that spread for a diagonal offset wanes it to a crescent,
     and box-shadow interpolates between the two. */
  .knob {
    position: absolute;
    top: var(--inset);
    left: var(--inset);
    width: var(--knob);
    height: var(--knob);
    border-radius: 50%;
    box-shadow: inset 0 0 0 calc(var(--knob) / 2 + 1px) var(--fg);
    transition: transform 0.28s ease, box-shadow 0.28s ease;
  }

  /* Knob at the far end, mirroring its inset at the near end. */
  .theme-toggle[aria-checked='true'] .knob {
    transform: translateX(
      calc(var(--track-w) - 2 * var(--edge) - var(--knob) - 2 * var(--inset))
    );
    box-shadow: inset 0.22rem -0.22rem 0 0 var(--fg);
  }

  @media (prefers-reduced-motion: reduce) {
    .track,
    .knob {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    const root = document.documentElement;
    const system = matchMedia('(prefers-color-scheme: dark)');
    // No stored choice means we are still following the OS.
    const current = () => root.dataset.theme || (system.matches ? 'dark' : 'light');
    const sync = () => btn.setAttribute('aria-checked', String(current() === 'dark'));

    sync();

    system.addEventListener('change', () => {
      if (!root.dataset.theme) {
        sync();
        window.dispatchEvent(new Event('themechange'));
      }
    });

    btn.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
      sync();
      // Canvases (fractals, Game of Life) read their palette from the CSS
      // variables and need to know the tokens moved under them.
      window.dispatchEvent(new Event('themechange'));
    });
  })();
</script>
