---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => (href.replace(/\/+$/, '') || '/') === path;

const pages = [
  { href: '/', label: 'Home' },
  { href: '/reading', label: 'Bookshelves' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/watching', label: 'Watching' },
  { href: '/fractals', label: 'Fractals' },
  { href: '/life', label: 'Game of Life' },
  { href: '/kaprekar', label: 'Kaprekar' },
  { href: 'https://libraryofbabel.info/', label: 'Library of Babel' },
  { href: 'https://www.yourworldoftext.com/oliviascharfman', label: 'World of Text' },
];

const elsewhere = [
  { href: 'https://oliviahelens.substack.com/', label: 'Substack' },
  { href: 'https://x.com/OliviaHelenS', label: 'X' },
  { href: 'https://www.linkedin.com/in/oliviascharfman/', label: 'LinkedIn' },
  { href: 'https://github.com/oliviahelens', label: 'GitHub' },
  { href: 'https://www.lesswrong.com/users/olivia-scharfman', label: 'LessWrong' },
  { href: 'https://open.spotify.com/user/12149517676?si=21244704ac1346a8', label: 'Spotify' },
  { href: '/contact', label: 'Contact' },
];

// Phones collapse the nav behind a toggle; label it with the page you are on,
// so the control says both where you are and what opening it is for.
const current = [...pages, ...elsewhere].find((l) => isCurrent(l.href));
const menuLabel = current ? current.label : 'Menu';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonical} />
    {description && <meta property="og:description" content={description} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@OliviaHelenS" />
    <Analytics />
  </head>
  <body>
    <div class="layout">
      <aside class="sidebar">
        <img
          class="portrait"
          src="/olivia.jpg"
          alt="Olivia H. Scharfman"
          width="400"
          height="400"
        />
        <details class="menu" open>
          <summary>
            <span class="menu-label">{menuLabel}</span>
            <span class="chevron" aria-hidden="true"></span>
          </summary>
          <nav class="links" aria-label="Site">
            <span class="divider" role="presentation"></span>
            {pages.map((l) => (
              <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
            ))}
            <span class="divider" role="presentation"></span>
            {elsewhere.map((l) => (
              <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
            ))}
          </nav>
        </details>
        <!-- Runs inline, right after the element, so the menu is already closed
             by the time a phone paints it. Without JS the nav stays open, which
             is the layout as it was before the toggle existed. -->
        <script is:inline>
          (() => {
            const menu = document.querySelector('.menu');
            const phone = matchMedia('(max-width: 48rem)');
            const sync = () => { menu.open = !phone.matches; };
            sync();
            phone.addEventListener('change', sync);
          })();
        </script>
      </aside>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
